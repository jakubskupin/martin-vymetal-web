                  "fontWeight": "500",
                  "letterSpacing": 3
                },
                {
                  "type": "text",
                  "id": "QP9Ji",
                  "name": "aboutP1",
                  "fill": "#1A1816",
                  "textGrowth": "fixed-width",
                  "width": 560,
                  "content": "Dvacet let v marketingu mě naučilo jednu věc — většina problémů není v taktice. Je v tom, jak lidé přemýšlejí.",
                  "lineHeight": 1.5,
                  "fontFamily": "Playfair Display",
                  "fontSize": 28,
                  "fontWeight": "normal",
                  "fontStyle": "italic"
                },
                {
                  "type": "text",
                  "id": "lH1EC",
                  "name": "aboutP2",
                  "fill": "#888880",
                  "textGrowth": "fixed-width",
                  "width": 560,
                  "content": "Pracoval jsem s firmami od startupů po korporáty. Prošel jsem Pacific Crest Trail. Napsal knihu. A pořád se vracím ke stejné otázce: co je podstatné?",
                  "lineHeight": 1.8,
                  "fontFamily": "Inter",
                  "fontSize": 16,
                  "fontWeight": "300"
                },
                {
                  "type": "text",
                  "id": "lPAqA",
                  "name": "aboutP3",
                  "fill": "#888880",
                  "textGrowth": "fixed-width",
                  "width": 560,
                  "content": "Dnes pomáhám lidem, kteří hledají jasný názor, ne další metodiku. Sídlím v Praze, ale nejspíš mě potkáte někde na horském treku.",
                  "lineHeight": 1.8,
                  "fontFamily": "Inter",
                  "fontSize": 16,
                  "fontWeight": "300"
                }
              ]
